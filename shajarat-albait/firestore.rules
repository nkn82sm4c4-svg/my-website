rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each host device (anonymous user) owns its family profile
    match /families/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Live sessions: anyone signed in may read (members join by code),
    // only the host who created the session may write it
    match /sessions/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.hostUid == request.auth.uid;
      allow update: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid
        && (resource.data.hostUid == request.auth.uid
            || !(resource.data.status in ['lobby', 'running', 'paused'])
            || request.time.toMillis() - resource.data.updatedAt > 6 * 3600 * 1000);

      // One presence doc per member device, written only by that device
      match /members/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid
          && request.resource.data.name is string && request.resource.data.name.size() <= 30;
      }
    }
  }
}
